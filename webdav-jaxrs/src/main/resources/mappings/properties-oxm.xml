<xml-bindings
        xmlns="http://www.eclipse.org/eclipselink/xsds/persistence/oxm"
        package-name="org.jugs.webdav.jaxrs.xml.properties">

    <xml-schema element-form-default="QUALIFIED">
        <xml-ns prefix="dav" namespace-uri="DAV:"/>
    </xml-schema>

    <java-types>
        <java-type name="CreationDate">
            <xml-root-element name="creationdate" namespace="DAV:"/>
        </java-type>
        <java-type name="DisplayName">
            <xml-root-element name="displayname" namespace="DAV:"/>
        </java-type>
        <java-type name="GetContentLanguage">
            <xml-root-element name="getcontentlanguage" namespace="DAV:"/>
        </java-type>
        <java-type name="GetContentLength">
            <xml-root-element name="getcontentlength" namespace="DAV:"/>
        </java-type>
        <java-type name="GetContentType">
            <xml-root-element name="getcontenttype" namespace="DAV:"/>
        </java-type>
        <java-type name="GetETag">
            <xml-root-element name="getetag" namespace="DAV:"/>
        </java-type>
        <java-type name="GetLastModified">
            <xml-root-element name="getlastmodified" namespace="DAV:"/>
        </java-type>
        <java-type name="LockDiscovery">
            <xml-root-element name="lockdiscovery" namespace="DAV:"/>
        </java-type>
        <java-type name="ResourceType">
            <xml-root-element name="resourcetype" namespace="DAV:"/>
        </java-type>
        <java-type name="SupportedLock">
            <xml-root-element name="supportedlock" namespace="DAV:"/>
        </java-type>
    </java-types>
</xml-bindings>
