<xml-bindings
        xmlns="http://www.eclipse.org/eclipselink/xsds/persistence/oxm"
        package-name="org.jugs.webdav.jaxrs.xml.conditions">

    <xml-schema element-form-default="QUALIFIED">
        <xml-ns prefix="dav" namespace-uri="DAV:"/>
    </xml-schema>

    <java-types>
        <java-type name="CannotModifyProtectedProperty">
            <xml-root-element name="cannot-modify-protected-property" namespace="DAV:"/>
        </java-type>
        <java-type name="LockTokenMatchesRequestUri">
            <xml-root-element name="lock-token-matches-request-uri" namespace="DAV:"/>
        </java-type>
        <java-type name="LockTokenSubmitted">
            <xml-root-element name="lock-token-submitted" namespace="DAV:"/>
        </java-type>
        <java-type name="NoConflictingLock">
            <xml-root-element name="no-conflicting-lock" namespace="DAV:"/>
        </java-type>
        <java-type name="NoExternalEntities">
            <xml-root-element name="no-external-entities" namespace="DAV:"/>
        </java-type>
        <java-type name="PreservedLiveProperties">
            <xml-root-element name="preserved-live-properties" namespace="DAV:"/>
        </java-type>
        <java-type name="PropFindFiniteDepth">
            <xml-root-element name="propfind-finite-depth" namespace="DAV:"/>
        </java-type>
    </java-types>
</xml-bindings>
