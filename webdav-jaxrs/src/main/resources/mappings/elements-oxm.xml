<xml-bindings
        xmlns="http://www.eclipse.org/eclipselink/xsds/persistence/oxm"
        package-name="org.jugs.webdav.jaxrs.xml.elements">

    <xml-schema element-form-default="QUALIFIED">
        <xml-ns prefix="dav" namespace-uri="DAV:"/>
    </xml-schema>

    <java-types>
        <java-type name="ActiveLock">
            <xml-root-element name="activelock" namespace="DAV:"/>
        </java-type>
        <java-type name="AllProp">
            <xml-root-element name="allprop" namespace="DAV:"/>
        </java-type>
        <java-type name="Collection">
            <xml-root-element name="collection" namespace="DAV:"/>
        </java-type>
        <java-type name="Depth">
            <xml-root-element name="depth" namespace="DAV:"/>
        </java-type>
        <java-type name="Error">
            <xml-root-element name="error" namespace="DAV:"/>
        </java-type>
        <java-type name="Exclusive">
            <xml-root-element name="exclusive" namespace="DAV:"/>
        </java-type>
        <java-type name="HRef">
            <xml-root-element name="href" namespace="DAV:"/>
        </java-type>
        <java-type name="Include">
            <xml-root-element name="include" namespace="DAV:"/>
        </java-type>
        <java-type name="Location">
            <xml-root-element name="location" namespace="DAV:"/>
        </java-type>
        <java-type name="LockEntry">
            <xml-root-element name="lockentry" namespace="DAV:"/>
        </java-type>
        <java-type name="LockInfo">
            <xml-root-element name="lockinfo" namespace="DAV:"/>
        </java-type>
        <java-type name="LockRoot">
            <xml-root-element name="lockroot" namespace="DAV:"/>
        </java-type>
        <java-type name="LockScope">
            <xml-root-element name="lockscope" namespace="DAV:"/>
        </java-type>
        <java-type name="LockToken">
            <xml-root-element name="locktoken" namespace="DAV:"/>
        </java-type>
        <java-type name="LockType">
            <xml-root-element name="locktype" namespace="DAV:"/>
        </java-type>
        <java-type name="MultiStatus">
            <xml-root-element name="multistatus" namespace="DAV:"/>
        </java-type>
        <java-type name="Owner">
            <xml-root-element name="owner" namespace="DAV:"/>
        </java-type>
        <java-type name="Prop">
            <xml-root-element name="prop" namespace="DAV:"/>
        </java-type>
        <java-type name="PropertyUpdate">
            <xml-root-element name="propertyupdate" namespace="DAV:"/>
        </java-type>
        <java-type name="PropFind">
            <xml-root-element name="propfind" namespace="DAV:"/>
        </java-type>
        <java-type name="PropName">
            <xml-root-element name="propname" namespace="DAV:"/>
        </java-type>
        <java-type name="PropStat">
            <xml-root-element name="propstat" namespace="DAV:"/>
        </java-type>
        <java-type name="Remove">
            <xml-root-element name="remove" namespace="DAV:"/>
        </java-type>
        <java-type name="Response">
            <xml-root-element name="response" namespace="DAV:"/>
        </java-type>
        <java-type name="ResponseDescription">
            <xml-root-element name="responsedescription" namespace="DAV:"/>
        </java-type>
        <java-type name="Set">
            <xml-root-element name="set" namespace="DAV:"/>
        </java-type>
        <java-type name="Shared">
            <xml-root-element name="shared" namespace="DAV:"/>
        </java-type>
        <java-type name="Status">
            <xml-root-element name="status" namespace="DAV:"/>
        </java-type>
        <java-type name="TimeOut">
            <xml-root-element name="timeout" namespace="DAV:"/>
        </java-type>
        <java-type name="Write">
            <xml-root-element name="write" namespace="DAV:"/>
        </java-type>
    </java-types>
</xml-bindings>
